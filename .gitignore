# Per-machine data, kept out of the public repo: run outputs (specs, reviews, logs)
# and repo profiles (repo names, deploy and rollback commands). Only the shelf notes are shared.
/runs/*
!/runs/CONTEXT.md
/repos/*
!/repos/CONTEXT.md
